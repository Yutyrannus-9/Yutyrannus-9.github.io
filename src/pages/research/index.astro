---
import { shown } from '../../data/site';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { mriOn } from '../../data/site';
import EntryCard from '../../components/EntryCard.astro';

const entries = (await getCollection('research', (e) => shown(e.data))).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Research" description="Research case studies: questions, methods, findings, and limitations, with status stated for each." mode="deep">
  <section class="panel" aria-labelledby="h">
    <p class="eyebrow">Deep</p>
    <h1 id="h" style="font-size:34px;margin:0 0 8px">Research</h1>
    <p style="margin:0">
      The cortex turns to glass so you can see the deep structures inside my brain{mriOn ? ', cut through by a slice of my own MRI. Scrolling moves the slice down; the buttons under the brain switch between axial, coronal, and sagittal.' : ', reconstructed from my own MRI.'}
      Click a structure to name it. These case studies are the work beneath the surface, and each one states its
      status plainly.
    </p>
  </section>
  <section class="panel" aria-label="Case studies">
    {entries.map((e) => (
      <EntryCard
        href={`/research/${e.id}`}
        title={e.data.title}
        summary={e.data.summary}
        status={e.data.status}
        source={e.data.source}
        tags={e.data.tags}
        cover={e.data.cover}
        meta={e.data.period}
      />
    ))}
  </section>
</Base>
